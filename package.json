{
	"name": "n8n-nodes-karrito",
	"version": "0.1.3",
	"description": "n8n nodes for Karrito, the simplest online store with WhatsApp checkout: orders, products, customers, categories, discounts and a new-order trigger.",
	"license": "MIT",
	"homepage": "https://github.com/curetcore/n8n-nodes-karrito#readme",
	"keywords": [
		"n8n-community-node-package",
		"karrito",
		"ecommerce",
		"whatsapp",
		"orders",
		"catalog"
	],
	"author": {
		"name": "Karrito",
		"email": "curetcore@gmail.com",
		"url": "https://karrito.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/curetcore/n8n-nodes-karrito.git"
	},
	"bugs": {
		"url": "https://github.com/curetcore/n8n-nodes-karrito/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/**/*.map"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/KarritoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Karrito/Karrito.node.js",
			"dist/nodes/KarritoTrigger/KarritoTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
